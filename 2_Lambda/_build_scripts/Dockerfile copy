# Use the official Amazon Linux 2023 base image
FROM public.ecr.aws/lambda/python:3.11 as build

# Install necessary build dependencies using yum
RUN yum -y update && \
    yum install -y python3 python3-devel gcc gcc-c++ make libffi-devel openssl-devel zip findutils curl && \
    yum clean all

# Set up the working directory
WORKDIR /workspace

# Install dependencies (use --no-cache-dir to save space)
RUN pip install --upgrade pip && \
    pip install --no-cache-dir spacy==3.7.4

# Download the en_core_web_sm model
RUN python -m spacy download en_core_web_sm

# Prepare the final minimal image
FROM public.ecr.aws/lambda/python:3.11

# Set up the working directory for the final layer
WORKDIR /opt

# Copy only the necessary parts from the build stage

# Copy Python site-packages (ensure we're copying the correct path)
COPY --from=build /usr/local/lib/python3.11/site-packages /opt/python/

# Copy the model folder from the build stage
COPY --from=build /workspace/en_core_web_sm /opt/en_core_web_sm

# Clean up unnecessary files
RUN rm -rf /opt/python/*/tests /opt/python/*/docs

# Create the zip file for the layer inside the Docker container
RUN cd /opt && \
    zip -r /opt/spacy-layer.zip . && \
    ls -lh /opt/spacy-layer.zip

# This will leave you with the final zip file, which you can copy out after running the container
