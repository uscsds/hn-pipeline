# Run Docker on local PC to build layers and upload to AWS via AWS CLI
docker pull amazonlinux:2023
# Run docker and mount required files to docker running directory (current PC's python version is 3.12)
docker run --rm -it \
  -v "$(pwd)/terraform/shared_layer:/app/terraform/shared_layer" \
  -v "$(pwd)/_build_scripts/build_layers.sh:/app/_build_scripts/build_layers.sh" \
  -v "$(pwd)/terraform/shared_layer/nltk_requirements.txt:/app/_build_scripts/nltk_requirements.txt" \
  -v "$(pwd)/terraform/shared_layer/spacy_requirements.txt:/app/_build_scripts/spacy_requirements.txt" \
  -v "$(pwd)/terraform/shared_layer/other_requirements.txt:/app/_build_scripts/other_requirements.txt" \
  -v "$(pwd)/_build_scripts/output:/app/output" \
  python:3.11-slim bash
# Inside Docker container now:
apt update && apt install -y zip gcc g++ build-essential binutils

# Confirm version
python3.11 --version
pip install nltk
pip install spacy

# Run build scripts inside docker
ls /app/terraform/shared_layer
ls /app/_build_scripts/build_layers.sh
cd /app/_build_scripts
bash build_layers.sh
# Exit Docker
exit
# Check output files
ls terraform/shared_layer/*.zip
# Run AWS CLI to upload layer zip files: Move to the folder where has the layer zip files. 
# run and get the ARN of layer to update Terraform script
aws lambda publish-layer-version \
  --layer-name hn-spacy-layer \
  --description "spaCy with en_core_web_sm model (cleaned) for HN project" \
  --zip-file fileb://terraform/shared_layer/spacy_layer.zip \
  --compatible-runtimes python3.11 \
  --region us-east-1
aws lambda publish-layer-version \
  --layer-name hn-nltk-layer \
  --description "NLTK dependencies for HN project" \
  --zip-file fileb://terraform/shared_layer/nltk_layer.zip \
  --compatible-runtimes python3.11 \
  --region us-east-1
aws lambda publish-layer-version \
  --layer-name hn-other-layer \
  --description "TextBlob, Requests, Boto3 dependencies for HN project" \
  --zip-file fileb://terraform/shared_layer/other_layer.zip \
  --compatible-runtimes python3.11 \
  --region us-east-1

# get the LayerVersionArn returned 

# Add layer for regex
docker run -it amazon/aws-lambda-python:3.11 bash
docker ps -a 
docker cp c87f5cec3d66:/opt/regex_layer.zip ./regex_layer.zip

# To list all update layer versions
aws lambda list-layer-versions --layer-name hn-spacy-layer --region us-east-1


