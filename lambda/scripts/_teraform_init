# layers built in docker are not compatible with AWS to run. So build layers in side EC2 instance and upload via AWS CLI
# Run AWS CLI to upload layer zip files: Move to the folder where has the layer zip files. 
# run and get the ARN of layer to update Terraform script
aws lambda publish-layer-version \
  --layer-name hn-spacy-layer \
  --description "spaCy with en_core_web_sm model (cleaned) for HN project" \
  --zip-file fileb://terraform/shared_layer/spacy_layer/spacy_layer.zip \
  --compatible-runtimes python3.11 \
  --region us-east-1
aws lambda publish-layer-version \
  --layer-name hn-nltk-layer \
  --description "NLTK, TextBlob dependencies for HN project" \
  --zip-file fileb://terraform/shared_layer/nltk_layer/nltk_layer.zip \
  --compatible-runtimes python3.11 \
  --region us-east-1
aws lambda publish-layer-version \
  --layer-name hn-other-layer \
  --description "Requests, Boto3 dependencies for HN project" \
  --zip-file fileb://terraform/shared_layer/other_layer/other_layer.zip \
  --compatible-runtimes python3.11 \
  --region us-east-1

# get the LayerVersionArn returned 

# Add layer for regex
#docker run -it amazon/aws-lambda-python:3.11 bash
#docker ps -a 
#docker cp c87f5cec3d66:/opt/regex_layer.zip ./regex_layer.zip

# To list all update layer versions
aws lambda list-layer-versions --layer-name hn-spacy-layer --region us-east-1







# Build spacy layer in docker file for faster
mkdir spacy_lambda_layer
cd spacy_lambda_layer
nano Dockerfile
# Build docker image
docker rmi spacy-layer
docker build -t spacy-layer .
docker images
# Run Docker container
docker rm spacylayercontainer
docker run --name spacylayercontainer --entrypoint bash spacy-layer
# Copy the built layer.zip to your local machine
# In a separate terminal (do NOT exit container!)
docker cp spacylayercontainer:/build/layer.zip ./spacy-layer.zip

# Clean up Docker container
docker rm spacylayercontainer

ls -lh spacy_layer.zip



